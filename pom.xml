<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.turkcell</groupId>
    <artifactId>telco-crm-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>telco-crm-platform</name>
    <description>Telco CRM Microservices Platform</description>

    <modules>
        <module>discovery-server</module>
        <module>config-server</module>
        <module>api-gateway</module>
        <module>product-catalog-service</module>
        <module>identity-service</module>
        <module>customer-service</module>
        <module>subscription-service</module>
        <module>payment-service</module>
        <module>usage-service</module>
        <module>billing-service</module>
        <module>notification-service</module>
        <module>ticket-service</module>
        <module>order-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- Her servis ayrı Swagger UI (Bölüm 11) - domain servisleri kendi pom.xml'inde
             springdoc-openapi-starter-webmvc-ui bağımlılığını bu sürümle ekler. -->
        <springdoc.version>2.8.17</springdoc.version>
        <!-- Resilience4j (Bölüm 10) - circuit breaker/retry/bulkhead, ilk olarak order-service'in
             Feign saga zincirinde kullanılıyor. -->
        <resilience4j.version>2.3.0</resilience4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- spring-cloud-dependencies, kendi ic'inde spring-cloud-circuitbreaker-dependencies:3.3.3
                 uzerinden resilience4j-bom'u 2.2.0'a sabitliyor (RxJava3 destegi yok, 2.3.0'daki fallback
                 autoconfig kodu RxJava3FallbackDecorator bekledigi icin context yuklenirken patlar).
                 Maven'da import edilen BOM'lar arasinda "ilk declare edilen kazanir" kurali gecerli
                 oldugu icin bizim 2.3.0 import'umuz BURADA, spring-cloud-dependencies'ten ONCE olmali. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Tüm servislerde ortak kullanacağımız dependency -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test dependency'si tüm modüller tarafından kullanılabilir -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Geliştirme kolaylığı için -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>